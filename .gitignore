# Publish only the static website and its deployment/license files.
/*
!/.gitignore
!/.nojekyll
!/LICENSE
!/index.html
!/styles.css
!/app.js
!/data.js
!/assets/

/assets/*
!/assets/favicon.svg
!/assets/audio/
!/assets/figures/

/assets/audio/*
!/assets/audio/*.mp3

/assets/figures/*
!/assets/figures/*.pdf
!/assets/figures/*.webp
